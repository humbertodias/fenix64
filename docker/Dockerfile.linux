# Linux x86_64 toolchain (Ubuntu 22.04 still ships SDL 1.2).
# Distro SDL/mixer -dev are for the shared artifacts. linux-deps.sh installs
# static SDL 1.2 + Ogg-only SDL_mixer into /opt/fenix-static for linux-static.
#   docker build --platform linux/amd64 -t fenix-linux -f docker/Dockerfile.linux docker/
#   bash scripts/docker-build.sh linux

FROM ubuntu:22.04

ARG TARGETPLATFORM
ENV DEBIAN_FRONTEND=noninteractive \
    PLATFORM=linux \
    FENIX_STATIC_PREFIX=/opt/fenix-static

RUN echo "fenix-linux ${TARGETPLATFORM}" \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        pkg-config \
        libsdl1.2-dev \
        libsdl-mixer1.2-dev \
        libpng-dev \
        zlib1g-dev \
        libgif-dev \
        libx11-dev \
        libxext-dev \
        libasound2-dev \
        libpulse-dev \
        libogg-dev \
        libvorbis-dev \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

COPY linux-deps.sh config.guess config.sub /tmp/
RUN bash /tmp/linux-deps.sh && rm -f /tmp/linux-deps.sh

WORKDIR /src
CMD ["bash"]
